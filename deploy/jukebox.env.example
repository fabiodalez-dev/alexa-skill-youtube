# Copia in /etc/jukebox.env (proprietario root:jukebox, permessi 640)

# OBBLIGATORIO. Chiave per firmare gli URL audio (almeno 32 caratteri).
# Generala con:  openssl rand -hex 32
# Con il valore "cambiami" il servizio si rifiuta di partire.
JUKEBOX_SECRET=cambiami

# OBBLIGATORIO. Indirizzo pubblico HTTPS del server, senza /alexa in fondo
# (l'endpoint della skill sarà questo indirizzo + /alexa).
# Con example.com il servizio si rifiuta di partire.
JUKEBOX_PUBLIC_URL=https://jukebox.example.com

# CONSIGLIATO. Skill ID dalla console Alexa, formato amzn1.ask.skill.xxxxxxxx-xxxx-...
# Vuoto = il server accetta richieste da qualsiasi skill: riempilo appena crei la skill.
JUKEBOX_SKILL_ID=

# FACOLTATIVO. Il tuo canale YouTube, per ascoltare le tue playlist PUBBLICHE per nome.
# Togli il # e metti il tuo handle.
# JUKEBOX_YT_CHANNEL=https://www.youtube.com/@tuocanale

# Facoltativi
# JUKEBOX_CACHE=/var/cache/jukebox
# JUKEBOX_CACHE_MB=8000
# JUKEBOX_DB=/var/lib/jukebox/state.sqlite
# JUKEBOX_DENO=/opt/jukebox/bin/deno
